{
  "name": "sealed-web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-fixtures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-fixtures.mjs",
    "build": "vite build",
    "test": "node --test && node --test ../../packages/web/server.test.mjs",
    "lint": "eslint . && npm run lint:shared",
    "lint:shared": "cd ../../packages/web && node ../../apps/web/node_modules/eslint/bin/eslint.js .",
    "format:check": "prettier --check src tests scripts vite.config.js eslint.config.js ../../packages/web",
    "format": "prettier --write src tests scripts vite.config.js eslint.config.js ../../packages/web",
    "test:browser": "node tests/browser-acceptance.mjs",
    "test:rendered": "node tests/rendered-acceptance.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "4.11.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright": "1.61.1",
    "prettier": "3.9.8",
    "vite": "^6.3.0"
  }
}
